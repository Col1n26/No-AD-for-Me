[General]
# 确保开启 MITM 解密
mitm = *.coolapk.com

[URL Rewrite]
# 匹配酷安相关请求并重定向或交由脚本处理
^https?:\/\/api\.coolapk\.com\/v6\/main\/init url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js
^https?:\/\/api\.coolapk\.com\/v6\/page\?url=.*tab* url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js

[Script]
# 脚本绑定配置
coolapk_script = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/(main\/init|page\?url=),script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js,requires-body=1,max-size=0,timeout=10
